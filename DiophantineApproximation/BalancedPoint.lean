/-!
# A balanced representative by one Minkowski scalar

**Layer 8.8.** The quantitative Subspace Theorem for a system (Layer 9.1, Q4.3) takes
`S`-integral points `z` and asks, through Evertse's normalization (2.4), that every form be at
most `C p · H_aff(z) ^ s(p)` at every place `p` of the system, with `∏ C p ≤ 1` and `s(p)` the
normalized local degree (`mult w / [K : ℚ]` at an infinite place, `0` at a finite one). A
projective point, such as a solution of the unit equation, has to be moved to such a
representative first. This file does that with **one nonzero `S`-integer `β`** from Minkowski's
theorem (`NumberField.exists_ne_zero_systemAbs_le`), and not with an `S`-unit:

* moving by an `S`-unit (Lemma 7.5.4, `NumberField.exists_forall_logHeightAff_smul_le`) costs the
  covering radius of the `S`-unit lattice, a constant that is only known to exist and is of the
  size of the `S`-regulator;
* moving by `β` costs `κ = scalarConst K S = 2 ^ [K : ℚ] ∏_{q ∈ S} N(q) √|D_K|`, the constant that
  the threshold of Q4.3 already carries.

`β` has `|β|_p ^ mult p ≤ B p` with `∏ B p = κ`; the product formula (`∏ |β|_p ≥ 1` for a
nonzero `S`-integer) bounds every `|β|_p` from below by `B p / κ`, so `β x` is balanced up to the
factor `κ`. The factor is pushed to **one finite place `P₀ ∈ S`**, where `β x` is made smaller
than `1 / κ`: there it costs nothing in the affine height, and it lets the constants be
`C w = κ ^ s(w)` at the infinite places and `C P₀ = κ⁻¹`, with product `1`
(`NumberField.systemConst_balancedConst`). So the representative satisfies the normalization
**exactly**, for every point at once, with the same constants. A set `S` without finite places
is enlarged by one prime first; the unit equation does not mind.

The representative is `S`-integral, so it sees the coefficients' common ideal outside `S`: the
`S`-product of the sup norms exceeds the height by the inverse of the finite part of the height of
the coefficients. That part is made at least `(2 ^ [K : ℚ] √|D_K|)⁻¹` by **one multiplier from
Minkowski's bound on ideal classes** (`NumberField.exists_mul_isIntegral_inv_le_finprod_iSup`):
the ideal generated by `c α` is the ideal of norm at most the Minkowski bound in the class of the
ideal of `α`. Then the `S`-product of the sup norms of `c α x`, `x` any `S`-units, is at most
`2 ^ [K : ℚ] √|D_K|` times its height (`NumberField.placeProd_iSup_le_mul_mulHeight`).

## Main definitions

* `NumberField.balancedConst`: the constants `κ ^ s(w)`, `κ⁻¹` at `P₀`, `1` elsewhere.

## Main results

* `NumberField.one_le_scalarConst`: `1 ≤ κ`.
* `NumberField.prod_iSup_pow_le_mulHeightAff`: the infinite part bounds the affine height below.
* `NumberField.affineProd_smul`: `affineProd (β x) = (∏ |β|_v) ^ n · affineProd x`.
* `NumberField.exists_smul_balanced`: **the balanced representative**.
* `NumberField.exists_mul_isIntegral`, `NumberField.exists_mul_isIntegral_inv_le_finprod_iSup`:
  a multiplier making a tuple integral, and one making it integral with the finite part of its
  height at least `(2 ^ [K : ℚ] √|D_K|)⁻¹`.
* `NumberField.placeProd_iSup_le_mul_mulHeight`: for such coefficients times `S`-units, the
  `S`-product of the sup norms is at most that constant times the height.
* `NumberField.exists_smul_systemValue_le`: every form at it is at most
  `balancedConst p · H_aff ^ s(p)`, and its product times its height is at most `κ ^ (n + 2)`
  times that of `x` over `S∞ ∪ S`.
* `NumberField.exists_absNorm_le_two_pow`: a prime of norm at most `2 ^ [K : ℚ]`.

This is milestone 8.8 of `DiophantineApproximation/README.md` (needed by S90.3 of
`Schlickewei1990/README.md`).
-/

@[expose] public section

open IsDedekindDomain Height Module

namespace NumberField

variable {K : Type*} [Field K] [NumberField K] (S : Finset (HeightOneSpectrum (𝓞 K)))

/-- **Minkowski's constant is at least `1`.** -/
theorem one_le_scalarConst : 1 ≤ scalarConst K S := by
  have h2 : (1 : ℝ) ≤ 2 ^ finrank ℚ K := one_le_pow₀ (by norm_num)
  have hN : (1 : ℝ) ≤ ∏ q ∈ S, (Ideal.absNorm q.asIdeal : ℝ) := by
    calc (1 : ℝ) = ∏ _q ∈ S, (1 : ℝ) := by simp
      _ ≤ _ := Finset.prod_le_prod₀ (fun _ _ ↦ zero_le_one) fun q _ ↦ Nat.one_le_cast.2
          (Nat.one_le_iff_ne_zero.2 fun h ↦ q.ne_bot (Ideal.absNorm_eq_zero_iff.1 h))
  have hD : (1 : ℝ) ≤ √|(discr K : ℝ)| :=
    Real.one_le_sqrt.2 (by exact_mod_cast Int.one_le_abs (discr_ne_zero K))
  exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le h2 hN) hD

/-- **The infinite part bounds the affine height from below.** -/
theorem prod_iSup_pow_le_mulHeightAff {ι : Type*} [Finite ι] (x : ι → K) :
    ∏ w : InfinitePlace K, (⨆ i, w (x i)) ^ w.mult ≤ mulHeightAff x := by
  set z : Option ι → K := fun o ↦ o.elim 1 x with hz
  have hbdd : ∀ f : Option ι → ℝ, BddAbove (Set.range f) := fun f ↦ Finite.bddAbove_range f
  have hone : ∀ v : AbsoluteValue K ℝ, 1 ≤ ⨆ o, v (z o) := fun v ↦
    le_ciSup_of_le (hbdd _) none (by simp [hz])
  rw [mulHeightAff, NumberField.mulHeight_eq (optionElim_one_ne_zero x)]
  refine le_trans ?_ (le_mul_of_one_le_right
    (Finset.prod_nonneg fun w _ ↦ pow_nonneg (zero_le_one.trans (hone w.1)) _)
    (one_le_finprod fun v : FinitePlace K ↦ hone v.1))
  refine Finset.prod_le_prod₀ (fun w _ ↦ pow_nonneg (Real.iSup_nonneg fun _ ↦ apply_nonneg _ _) _)
    fun w _ ↦ pow_le_pow_left₀ (Real.iSup_nonneg fun _ ↦ apply_nonneg _ _) ?_ _
  exact Real.iSup_le (fun i ↦ le_ciSup_of_le (hbdd fun o ↦ w (z o)) (some i) le_rfl)
    (zero_le_one.trans (hone w.1))

/-- **Scaling a point by `β` scales the affine product by `(∏_{v ∈ S∞ ∪ S} ‖β‖_v) ^ n`.** -/
theorem affineProd_smul {ι : Type*} [Fintype ι] (L : AbsoluteValue K ℝ → ι → Dual K (ι → K))
    (β : K) (x : ι → K) :
    affineProd S (fun v ↦ v) L (β • x) =
      placeProd S Set.univ (fun v ↦ v β) ^ Fintype.card ι * affineProd S (fun v ↦ v) L x := by
  have hL : ∀ v i, L v i (fun j ↦ algebraMap K K ((β • x) j)) =
      β * L v i (fun j ↦ algebraMap K K (x j)) := by
    intro v i
    simp only [Algebra.algebraMap_self, RingHom.id_apply]
    rw [show (fun j ↦ (β • x) j) = β • x from rfl, map_smul, smul_eq_mul]
  unfold affineProd placeProd
  simp only [hL, map_mul, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
    Set.mulIndicator_univ, mul_pow, ← pow_mul, ← Finset.prod_pow]
  simp only [mul_comm (Fintype.card ι)]
  ring

open scoped Classical in
/-- **The constants of a balanced system**: `κ ^ s(w)` at an infinite place `w`, `κ⁻¹` at `P₀`
and `1` at the other places of `S`, with `κ = scalarConst K S`. -/
noncomputable def balancedConst (P₀ : HeightOneSpectrum (𝓞 K)) : InfinitePlace K ⊕ S → ℝ :=
  Sum.elim (fun w ↦ scalarConst K S ^ ((w.mult : ℝ) / finrank ℚ K))
    fun P ↦ if P.1 = P₀ then (scalarConst K S)⁻¹ else 1

open scoped Classical in
theorem balancedConst_pos (P₀ : HeightOneSpectrum (𝓞 K)) (p : InfinitePlace K ⊕ S) :
    0 < balancedConst S P₀ p := by
  have hκ : 0 < scalarConst K S := scalarConst_pos S
  rcases p with w | P
  · exact Real.rpow_pos_of_pos hκ _
  · simp only [balancedConst, Sum.elim_inr]
    split_ifs
    · exact inv_pos.2 hκ
    · exact one_pos

open scoped Classical in
/-- **The constants of a balanced system multiply to `1`.** -/
theorem systemConst_balancedConst {P₀ : HeightOneSpectrum (𝓞 K)} (hP₀ : P₀ ∈ S) :
    systemConst (balancedConst S P₀) = 1 := by
  have hκ : 0 < scalarConst K S := scalarConst_pos S
  have hD : (0 : ℝ) < finrank ℚ K := Nat.cast_pos.mpr finrank_pos
  rw [systemConst, Fintype.prod_sum_type]
  simp only [balancedConst, Sum.elim_inl, Sum.elim_inr]
  rw [← Real.rpow_sum_of_pos hκ, ← Finset.sum_div, ← Nat.cast_sum, InfinitePlace.sum_mult_eq,
    div_self hD.ne', Real.rpow_one,
    Finset.prod_coe_sort S (fun P ↦ if P = P₀ then (scalarConst K S)⁻¹ else 1),
    Finset.prod_ite_eq' S P₀, ite_eq_left hP₀, mul_inv_cancel₀ hκ.ne']

open scoped Classical in
/-- **The balanced representative.** For `P₀ ∈ S` and a nonzero `S`-integral `x`, some nonzero
`S`-integer `β` with `∏_{v ∈ S∞ ∪ S} ‖β‖_v ≤ κ` makes `β x` at most `κ⁻¹` at `P₀`, at most `1` at
the other places of `S`, and at most `(κ H_aff(β x)) ^ s(w)` at every infinite place `w`, with
`κ ∏_{S∞ ∪ S} ‖x‖_v ≤ H_aff(β x) ≤ κ² ∏_{S∞ ∪ S} ‖x‖_v`. Here `κ = scalarConst K S`. -/
theorem exists_smul_balanced {ι : Type*} [Finite ι] {P₀ : HeightOneSpectrum (𝓞 K)} (hP₀ : P₀ ∈ S)
    {x : ι → K} (hx : x ≠ 0) (hxS : ∀ i, x i ∈ (S : Set (HeightOneSpectrum (𝓞 K))).integer K) :
    ∃ β : K, β ≠ 0 ∧ β ∈ (S : Set (HeightOneSpectrum (𝓞 K))).integer K ∧
      placeProd S Set.univ (fun v ↦ v β) ≤ scalarConst K S ∧
      (∀ P ∈ S, ⨆ i, (FinitePlace.mk P).1 (β * x i) ≤
        if P = P₀ then (scalarConst K S)⁻¹ else 1) ∧
      (∀ w : InfinitePlace K, (⨆ i, w.1 (β * x i)) ^ w.mult ≤
        (scalarConst K S * mulHeightAff (β • x)) ^ ((w.mult : ℝ) / finrank ℚ K)) ∧
      scalarConst K S * placeProd S Set.univ (fun v ↦ ⨆ i, v (x i)) ≤ mulHeightAff (β • x) ∧
      mulHeightAff (β • x) ≤
        scalarConst K S ^ 2 * placeProd S Set.univ (fun v ↦ ⨆ i, v (x i)) := by
  set κ := scalarConst K S with hκ
  have hκ1 : 1 ≤ κ := one_le_scalarConst S
  have hκ0 : 0 < κ := by linarith
  set M : AbsoluteValue K ℝ → ℝ := fun v ↦ ⨆ i, v (x i) with hM
  obtain ⟨i₀, hi₀⟩ := Function.ne_iff.mp hx
  have hle : ∀ (v : AbsoluteValue K ℝ) i, v (x i) ≤ M v := fun v i ↦
    le_ciSup (f := fun i ↦ v (x i)) (Finite.bddAbove_range _) i
  have hMpos : ∀ v, 0 < M v := fun v ↦ (v.pos hi₀).trans_le (hle v i₀)
  set PS := placeProd S Set.univ M with hPS
  have hPS1 : 1 ≤ PS := (one_le_mulHeight x).trans (mulHeight_le_placeProd_univ S hx hxS)
  have hPSeq : PS =
      (∏ w : InfinitePlace K, M w.1 ^ w.mult) * ∏ P ∈ S, M (FinitePlace.mk P).1 := by
    simp only [hPS, placeProd, Set.mulIndicator_univ]
  set D : ℝ := (finrank ℚ K : ℝ) with hD
  have hDpos : 0 < D := Nat.cast_pos.mpr finrank_pos
  set G := κ ^ 2 * PS with hG
  have hG1 : 1 ≤ G := one_le_mul_of_one_le_of_one_le (one_le_pow₀ hκ1) hPS1
  have hG0 : 0 < G := by linarith
  set B : InfinitePlace K ⊕ S → ℝ := Sum.elim (fun w ↦ G ^ ((w.mult : ℝ) / D) / M w.1 ^ w.mult)
    (fun P ↦ (if P.1 = P₀ then κ⁻¹ else 1) / M (FinitePlace.mk P.1).1) with hB
  have hBpos : ∀ p, 0 < B p := by
    rintro (w | P)
    · exact div_pos (Real.rpow_pos_of_pos hG0 _) (pow_pos (hMpos _) _)
    · simp only [hB, Sum.elim_inr]
      refine div_pos ?_ (hMpos _)
      split_ifs
      · exact inv_pos.2 hκ0
      · exact one_pos
  have hprodB : ∏ p, B p = κ := by
    have hA : ∏ w : InfinitePlace K, M w.1 ^ w.mult ≠ 0 :=
      Finset.prod_ne_zero_iff.2 fun w _ ↦ (pow_pos (hMpos _) _).ne'
    have hA' : ∏ P ∈ S, M (FinitePlace.mk P).1 ≠ 0 :=
      Finset.prod_ne_zero_iff.2 fun P _ ↦ (hMpos _).ne'
    rw [Fintype.prod_sum_type]
    simp only [hB, Sum.elim_inl, Sum.elim_inr]
    rw [Finset.prod_div_distrib, Finset.prod_div_distrib, ← Real.rpow_sum_of_pos hG0,
      ← Finset.sum_div, ← Nat.cast_sum, InfinitePlace.sum_mult_eq, div_self hDpos.ne',
      Real.rpow_one, Finset.prod_coe_sort S (fun P ↦ if P = P₀ then κ⁻¹ else 1),
      Finset.prod_coe_sort S (fun P ↦ M (FinitePlace.mk P).1), Finset.prod_ite_eq' S P₀,
      ite_eq_left hP₀, hG, hPSeq]
    field_simp
  obtain ⟨β, hβ0, hβS, hβB⟩ := exists_ne_zero_systemAbs_le S hBpos hprodB.symm.le
  have hβw : ∀ w : InfinitePlace K,
      w.1 β ^ w.mult * M w.1 ^ w.mult ≤ G ^ ((w.mult : ℝ) / D) := by
    intro w
    have h := hβB (.inl w)
    simp only [systemPlace, systemMult, hB, Sum.elim_inl] at h
    rwa [le_div_iff₀ (pow_pos (hMpos _) _)] at h
  have hβP : ∀ P ∈ S, (FinitePlace.mk P).1 β * M (FinitePlace.mk P).1 ≤
      if P = P₀ then κ⁻¹ else 1 := by
    intro P hP
    have h := hβB (.inr ⟨P, hP⟩)
    simp only [systemPlace, systemMult, hB, Sum.elim_inr, pow_one] at h
    rwa [le_div_iff₀ (hMpos _)] at h
  have hβle : placeProd S Set.univ (fun v ↦ v β) ≤ κ := by
    have hβprod : placeProd S Set.univ (fun v ↦ v β) =
        ∏ p, systemPlace S p β ^ systemMult S p := by
      rw [Fintype.prod_sum_type]
      simp only [placeProd, Set.mulIndicator_univ, systemPlace, systemMult, pow_one]
      rw [Finset.prod_coe_sort S (fun P ↦ (FinitePlace.mk P).1 β)]
    rw [hβprod, ← hprodB]
    exact Finset.prod_le_prod₀ (fun p _ ↦ pow_nonneg (apply_nonneg _ _) _) fun p _ ↦ hβB p
  have hβ1 : 1 ≤ placeProd S Set.univ (fun v ↦ v β) :=
    one_le_placeProd_univ_of_mem_integer S hβS hβ0
  have hite : ∀ P, 0 ≤ (if P = P₀ then κ⁻¹ else 1) ∧ (if P = P₀ then κ⁻¹ else 1) ≤ 1 := by
    intro P
    split_ifs
    · exact ⟨inv_nonneg.2 hκ0.le, inv_le_one_of_one_le₀ hκ1⟩
    · exact ⟨zero_le_one, le_rfl⟩
  have hfin : ∀ P ∈ S, ⨆ i, (FinitePlace.mk P).1 (β * x i) ≤ if P = P₀ then κ⁻¹ else 1 := by
    intro P hP
    refine Real.iSup_le (fun i ↦ ?_) (hite P).1
    rw [map_mul]
    exact (mul_le_mul_of_nonneg_left (hle _ i) (apply_nonneg _ _)).trans (hβP P hP)
  have hinf : ∀ w : InfinitePlace K,
      (⨆ i, w.1 (β * x i)) ^ w.mult ≤ G ^ ((w.mult : ℝ) / D) := by
    intro w
    refine (pow_le_pow_left₀ (Real.iSup_nonneg fun _ ↦ apply_nonneg _ _) (Real.iSup_le
      (fun i ↦ ?_) (mul_nonneg (w.1.nonneg β) (hMpos w.1).le)) _).trans ?_
    · rw [map_mul]
      exact mul_le_mul_of_nonneg_left (hle _ i) (apply_nonneg _ _)
    · rw [mul_pow]
      exact hβw w
  have hzS : ∀ i, (β • x) i ∈ (S : Set (HeightOneSpectrum (𝓞 K))).integer K :=
    fun i ↦ mul_mem hβS (hxS i)
  have hlow : κ * PS ≤ mulHeightAff (β • x) := by
    have hPz : placeProd S Set.univ (fun v ↦ ⨆ i, v (β * x i)) =
        (∏ w : InfinitePlace K, (⨆ i, w.1 (β * x i)) ^ w.mult) *
          ∏ P ∈ S, ⨆ i, (FinitePlace.mk P).1 (β * x i) := by
      simp only [placeProd, Set.mulIndicator_univ]
    have hfinprod : ∏ P ∈ S, ⨆ i, (FinitePlace.mk P).1 (β * x i) ≤ κ⁻¹ := by
      calc _ ≤ ∏ P ∈ S, (if P = P₀ then κ⁻¹ else 1) :=
            Finset.prod_le_prod₀ (fun P _ ↦ Real.iSup_nonneg fun _ ↦ apply_nonneg _ _) hfin
        _ = κ⁻¹ := by rw [Finset.prod_ite_eq' S P₀, ite_eq_left hP₀]
    have hinfprod : ∏ w : InfinitePlace K, (⨆ i, w.1 (β * x i)) ^ w.mult ≤
        mulHeightAff (β • x) := prod_iSup_pow_le_mulHeightAff (β • x)
    have hnn : 0 ≤ ∏ w : InfinitePlace K, (⨆ i, w.1 (β * x i)) ^ w.mult :=
      Finset.prod_nonneg fun w _ ↦ pow_nonneg (Real.iSup_nonneg fun _ ↦ apply_nonneg _ _) _
    calc κ * PS ≤ κ * (placeProd S Set.univ (fun v ↦ v β) * PS) := by
          gcongr
          exact le_mul_of_one_le_left (by linarith) hβ1
      _ = κ * placeProd S Set.univ (fun v ↦ ⨆ i, v (β * x i)) := by
          rw [placeProd_univ_iSup_mul]
      _ ≤ κ * ((∏ w : InfinitePlace K, (⨆ i, w.1 (β * x i)) ^ w.mult) * κ⁻¹) := by
          rw [hPz]
          gcongr
      _ = ∏ w : InfinitePlace K, (⨆ i, w.1 (β * x i)) ^ w.mult := by
          field_simp
      _ ≤ mulHeightAff (β • x) := hinfprod
  have hup : mulHeightAff (β • x) ≤ G := by
    have hint : ∀ v : FinitePlace K, v ∉ (∅ : Finset (FinitePlace K)) →
        ∀ i, v ((β • x) i) ≤ 1 := by
      intro v _ i
      obtain ⟨P, rfl⟩ : ∃ P, FinitePlace.mk P = v := ⟨v.maximalIdeal, FinitePlace.mk_maximalIdeal v⟩
      by_cases hP : P ∈ S
      · change (FinitePlace.mk P).1 (β * x i) ≤ 1
        exact (le_ciSup (f := fun i ↦ (FinitePlace.mk P).1 (β * x i))
          (Finite.bddAbove_range _) i).trans ((hfin P hP).trans (hite P).2)
      · exact (Set.mem_integer_iff_finitePlace _ _).mp (hzS i) P (by simpa using hP)
    have h := logHeightAff_le_sum_posLog hint
    simp only [Finset.sum_empty, add_zero] at h
    have hterm : ∀ w : InfinitePlace K, (w.mult : ℝ) * Real.posLog (⨆ i, w ((β • x) i)) ≤
        ((w.mult : ℝ) / D) * Real.log G := by
      intro w
      have hw := hinf w
      have ht0 : 0 ≤ ⨆ i, w ((β • x) i) := Real.iSup_nonneg fun _ ↦ apply_nonneg _ _
      rw [Real.posLog_eq_log_max_one ht0, ← Real.log_pow, ← Real.log_rpow hG0]
      refine Real.log_le_log (pow_pos (lt_max_of_lt_left one_pos) _) ?_
      rcases le_total (⨆ i, w ((β • x) i)) 1 with ht | ht
      · rw [max_eq_left ht, one_pow]
        exact Real.one_le_rpow hG1 (by positivity)
      · rw [max_eq_right ht]
        exact hw
    have hsum : ∑ w : InfinitePlace K, ((w.mult : ℝ) / D) * Real.log G = Real.log G := by
      rw [← Finset.sum_mul, ← Finset.sum_div, ← Nat.cast_sum, InfinitePlace.sum_mult_eq,
        div_self hDpos.ne', one_mul]
    have hlog : logHeightAff (β • x) ≤ Real.log G :=
      h.trans ((Finset.sum_le_sum fun w _ ↦ hterm w).trans hsum.le)
    rw [logHeightAff_eq_log_mulHeightAff] at hlog
    exact (Real.log_le_log_iff (mulHeightAff_pos _) hG0).1 hlog
  refine ⟨β, hβ0, hβS, hβle, hfin, fun w ↦ (hinf w).trans ?_, hlow, hup⟩
  refine Real.rpow_le_rpow hG0.le ?_ (by positivity)
  calc G = κ * (κ * PS) := by ring
    _ ≤ κ * mulHeightAff (β • x) := by gcongr

open scoped Classical in
/-- **A system for the balanced representative.** If every form is at most the sup norm of `x`
at the places of `S∞ ∪ S`, then for the balanced representative `β x` every form is at most
`balancedConst p · H_aff(β x) ^ s(p)` at every place `p` of the system (the constants multiply to
`1`, `NumberField.systemConst_balancedConst`), and the affine product of `β x` times its affine
height is at most `κ ^ (n + 2)` times the affine product of `x` times its sup norms over
`S∞ ∪ S`; and the affine height of `β x` is at most `κ²` times its own sup norms over
`S∞ ∪ S`. -/
theorem exists_smul_systemValue_le {ι : Type*} [Fintype ι] {P₀ : HeightOneSpectrum (𝓞 K)}
    (hP₀ : P₀ ∈ S) {x : ι → K} (hx : x ≠ 0)
    (hxS : ∀ i, x i ∈ (S : Set (HeightOneSpectrum (𝓞 K))).integer K)
    (L : AbsoluteValue K ℝ → ι → Dual K (ι → K))
    (hL : ∀ v ∈ relevantPlaces S, ∀ i, v (L v i x) ≤ ⨆ j, v (x j)) :
    ∃ β : K, β ≠ 0 ∧ (∀ i, (β • x) i ∈ (S : Set (HeightOneSpectrum (𝓞 K))).integer K) ∧
      (∀ p i, systemValue S (fun v ↦ v) L p i (β • x) ≤
        balancedConst S P₀ p * mulHeightAff (β • x) ^ systemExponent S p) ∧
      affineProd S (fun v ↦ v) L (β • x) * mulHeightAff (β • x) ≤
        scalarConst K S ^ (Fintype.card ι + 2) *
          (affineProd S (fun v ↦ v) L x * placeProd S Set.univ (fun v ↦ ⨆ i, v (x i))) ∧
      mulHeightAff (β • x) ≤
        scalarConst K S ^ 2 * placeProd S Set.univ (fun v ↦ ⨆ i, v ((β • x) i)) := by
  obtain ⟨β, hβ0, hβS, hβle, hfin, hinf, -, hup⟩ := exists_smul_balanced S hP₀ hx hxS
  have hκ0 : 0 < scalarConst K S := scalarConst_pos S
  have hLβ : ∀ v ∈ relevantPlaces S, ∀ i, v (L v i (β • x)) ≤ ⨆ j, v (β * x j) := by
    intro v hv i
    simp only [map_smul, smul_eq_mul, map_mul]
    rw [← Real.mul_iSup_of_nonneg (v.nonneg β)]
    exact mul_le_mul_of_nonneg_left (hL v hv i) (v.nonneg β)
  refine ⟨β, hβ0, fun i ↦ mul_mem hβS (hxS i), fun p i ↦ ?_, ?_, hup.trans ?_⟩
  · rcases p with w | P
    · have hv : w.1 ∈ relevantPlaces S := by unfold relevantPlaces; exact Or.inl ⟨w, rfl⟩
      simp only [systemValue, systemAbs, systemPlace, systemMult, systemExponent, balancedConst,
        Sum.elim_inl, Algebra.algebraMap_self, RingHom.id_apply]
      rw [← Real.mul_rpow hκ0.le (mulHeightAff_pos _).le]
      exact (pow_le_pow_left₀ (apply_nonneg _ _) (hLβ w.1 hv i) _).trans (hinf w)
    · have hv : (FinitePlace.mk P.1).1 ∈ relevantPlaces S := by
        unfold relevantPlaces; exact Or.inr ⟨P.1, P.2, rfl⟩
      simp only [systemValue, systemAbs, systemPlace, systemMult, systemExponent, balancedConst,
        Sum.elim_inr, Algebra.algebraMap_self, RingHom.id_apply, pow_one, Real.rpow_zero,
        mul_one]
      exact (hLβ _ hv i).trans (hfin P.1 P.2)
  · have hA := affineProd_nonneg S (fun v ↦ v) L x
    have hPS : 0 ≤ placeProd S Set.univ (fun v ↦ ⨆ i, v (x i)) :=
      placeProd_nonneg S _ fun v _ ↦ Real.iSup_nonneg fun _ ↦ apply_nonneg _ _
    rw [affineProd_smul]
    calc placeProd S Set.univ (fun v ↦ v β) ^ Fintype.card ι * affineProd S (fun v ↦ v) L x *
          mulHeightAff (β • x) ≤ scalarConst K S ^ Fintype.card ι *
            affineProd S (fun v ↦ v) L x * (scalarConst K S ^ 2 *
              placeProd S Set.univ (fun v ↦ ⨆ i, v (x i))) :=
          mul_le_mul (mul_le_mul_of_nonneg_right (pow_le_pow_left₀
            (placeProd_nonneg S _ fun v _ ↦ v.nonneg β) hβle _) hA) hup
            (mulHeightAff_pos _).le (mul_nonneg (pow_nonneg hκ0.le _) hA)
      _ = _ := by ring
  · simp only [Pi.smul_apply, smul_eq_mul]
    rw [placeProd_univ_iSup_mul]
    refine mul_le_mul_of_nonneg_left (le_mul_of_one_le_left
      (placeProd_nonneg S _ fun v _ ↦ Real.iSup_nonneg fun _ ↦ apply_nonneg _ _)
      (one_le_placeProd_univ_of_mem_integer S hβS hβ0)) (pow_nonneg hκ0.le _)

/-! ### Normalizing the coefficients -/

/-- **A tuple can be made algebraic integers** by one nonzero multiplier. -/
theorem exists_mul_isIntegral {ι : Type*} [Finite ι] (α : ι → K) :
    ∃ c : K, c ≠ 0 ∧ ∀ i, IsIntegral ℤ (c * α i) := by
  classical
  have := Fintype.ofFinite ι
  have : Algebra.IsAlgebraic ℤ K :=
    ⟨fun a ↦ (IsFractionRing.isAlgebraic_iff ℤ ℚ K).2 (Algebra.IsAlgebraic.isAlgebraic a)⟩
  obtain ⟨y, hy0, hy⟩ := Algebra.IsAlgebraic.exists_integral_multiples ℤ (Finset.univ.image α)
  refine ⟨(y : K), by exact_mod_cast hy0, fun i ↦ ?_⟩
  simpa [zsmul_eq_mul] using hy (α i) (Finset.mem_image_of_mem _ (Finset.mem_univ i))

open Ideal InfinitePlace Pointwise in
open scoped nonZeroDivisors Real in
/-- **Minkowski's bound for the ideal of a tuple.** A tuple of algebraic integers, not all zero,
has a multiple `(x⁻¹ y) a` that is again integral and generates an ideal of norm at most the
Minkowski bound: the ideal of norm at most the bound in the class of the ideal of `a`. -/
private theorem exists_absNorm_span_le {ι : Type*} (a : ι → 𝓞 K)
    (ha : ∃ i, a i ≠ 0) :
    ∃ b : ι → 𝓞 K, ∃ x y : 𝓞 K, x ≠ 0 ∧ y ≠ 0 ∧ (∀ i, x * b i = y * a i) ∧
      (absNorm (span (Set.range b)) : ℝ) ≤ (4 / π) ^ nrComplexPlaces K *
        ((finrank ℚ K).factorial / (finrank ℚ K) ^ (finrank ℚ K) * √|discr K|) := by
  classical
  set 𝔞 := span (Set.range a) with h𝔞
  have h𝔞0 : 𝔞 ≠ ⊥ := by
    obtain ⟨i, hi⟩ := ha
    intro h
    exact hi (by simpa using (Ideal.span_eq_bot.1 h) (a i) ⟨i, rfl⟩)
  have h𝔞m : 𝔞 ∈ (Ideal (𝓞 K))⁰ := mem_nonZeroDivisors_iff_ne_zero.2 h𝔞0
  obtain ⟨I, hI, hIn⟩ := exists_ideal_in_class_of_norm_le (ClassGroup.mk0 ⟨𝔞, h𝔞m⟩)
  obtain ⟨x, y, hx, hy, hxy⟩ := (ClassGroup.mk0_eq_mk0_iff).1 hI
  have hmem : ∀ i, ∃ b ∈ (I : Ideal (𝓞 K)), x * b = y * a i := fun i ↦ by
    have : y * a i ∈ span {y} * 𝔞 :=
      Ideal.mul_mem_mul (Ideal.mem_span_singleton_self y) (Ideal.subset_span ⟨i, rfl⟩)
    rw [← hxy] at this
    exact (Ideal.mem_span_singleton_mul).1 this
  choose b hbI hb using hmem
  refine ⟨b, x, y, hx, hy, hb, ?_⟩
  have hrange : ({x} : Set (𝓞 K)) * Set.range b = {y} * Set.range a := by
    rw [Set.singleton_mul, Set.singleton_mul, ← Set.range_comp, ← Set.range_comp]
    congr 1
    funext i
    exact hb i
  have hspan : span (Set.range b) = (I : Ideal (𝓞 K)) := by
    rw [← span_singleton_mul_right_inj hx, hxy, span_mul_span, span_mul_span, hrange]
  rw [hspan]
  exact_mod_cast hIn

open InfinitePlace in
open scoped Real in
/-- The Minkowski bound is at most `2 ^ [K : ℚ] √|D_K|`. -/
private theorem minkowskiBound_le :
    (4 / π) ^ nrComplexPlaces K *
        ((finrank ℚ K).factorial / (finrank ℚ K) ^ (finrank ℚ K) * √|(discr K : ℝ)|) ≤
      2 ^ finrank ℚ K * √|(discr K : ℝ)| := by
  have hπ : 4 / π ≤ 2 := by
    rw [div_le_iff₀ Real.pi_pos]
    linarith [Real.pi_gt_three]
  have hr : nrComplexPlaces K ≤ finrank ℚ K := by
    have := card_add_two_mul_card_eq_rank K
    omega
  have h1 : (4 / π) ^ nrComplexPlaces K ≤ 2 ^ finrank ℚ K :=
    (pow_le_pow_left₀ (by positivity) hπ _).trans (pow_le_pow_right₀ (by norm_num) hr)
  have h2 : ((finrank ℚ K).factorial : ℝ) / (finrank ℚ K) ^ (finrank ℚ K) ≤ 1 := by
    rw [div_le_one (by have := finrank_pos (R := ℚ) (M := K); positivity)]
    exact_mod_cast Nat.factorial_le_pow _
  have hD : 0 ≤ √|(discr K : ℝ)| := Real.sqrt_nonneg _
  calc _ ≤ 2 ^ finrank ℚ K * (1 * √|(discr K : ℝ)|) := by gcongr
    _ = _ := by ring

/-- **The coefficients can be normalized by one multiplier.** A tuple `α`, not all zero, has a
multiple `c α` of algebraic integers whose finite part of the height,
`∏_{v ∤ ∞} max_i ‖c αᵢ‖_v`, is at least `(2 ^ [K : ℚ] √|D_K|)⁻¹`: the inverse norm of the ideal
generated by `c α`, which is the ideal of norm at most the Minkowski bound in the class of the
ideal of `α`. -/
theorem exists_mul_isIntegral_inv_le_finprod_iSup {ι : Type*} [Finite ι] {α : ι → K}
    (hα : α ≠ 0) :
    ∃ c : K, c ≠ 0 ∧ (∀ i, IsIntegral ℤ (c * α i)) ∧
      (2 ^ finrank ℚ K * √|(discr K : ℝ)|)⁻¹ ≤ ∏ᶠ v : FinitePlace K, ⨆ i, v (c * α i) := by
  obtain ⟨c₀, hc₀, hint⟩ := exists_mul_isIntegral α
  obtain ⟨i₀, hi₀⟩ := Function.ne_iff.mp hα
  set a : ι → 𝓞 K := fun i ↦ ⟨c₀ * α i, hint i⟩ with ha
  have ha0 : a i₀ ≠ 0 := fun h ↦ mul_ne_zero hc₀ hi₀ (congrArg ((↑) : 𝓞 K → K) h)
  obtain ⟨b, x, y, hx, hy, hb, hbn⟩ := exists_absNorm_span_le a ⟨i₀, ha0⟩
  have hxK : (x : K) ≠ 0 := by exact_mod_cast hx
  have hyK : (y : K) ≠ 0 := by exact_mod_cast hy
  have hbK : ∀ i, (b i : K) = c₀ * y / x * α i := fun i ↦ by
    have h : (x : K) * b i = y * (c₀ * α i) := by
      have := congrArg (algebraMap (𝓞 K) K) (hb i)
      rwa [map_mul, map_mul] at this
    field_simp
    linear_combination h
  have hb0 : b i₀ ≠ 0 := fun h ↦
    (mul_ne_zero (div_ne_zero (mul_ne_zero hc₀ hyK) hxK) hi₀) (by rw [← hbK, h]; simp)
  refine ⟨c₀ * y / x, div_ne_zero (mul_ne_zero hc₀ hyK) hxK,
    fun i ↦ (hbK i) ▸ (b i).isIntegral_coe, ?_⟩
  have hfin : ∏ᶠ v : FinitePlace K, ⨆ i, v (c₀ * y / x * α i) =
      ((Ideal.absNorm (Ideal.span (Set.range b)) : ℝ))⁻¹ := by
    rw [← FinitePlace.finprod_iSup_eq_inv_absNorm ⟨i₀, hb0⟩]
    simp only [hbK]
  rw [hfin]
  have hpos : (0 : ℝ) < Ideal.absNorm (Ideal.span (Set.range b)) := by
    have : Ideal.span (Set.range b) ≠ ⊥ := fun h ↦
      hb0 (by simpa using (Ideal.span_eq_bot.1 h) (b i₀) ⟨i₀, rfl⟩)
    exact_mod_cast Nat.pos_of_ne_zero (fun h ↦ this (Ideal.absNorm_eq_zero_iff.1 h))
  exact inv_anti₀ hpos (hbn.trans minkowskiBound_le)

/-- **The `S`-product of a normalized point is at most a constant times its height.** If the
finite part of the height of the integral tuple `u` is at least `m⁻¹`, then for `S`-units `x` the
point `y = u x` has `∏_{v ∈ S∞ ∪ S} max_i ‖yᵢ‖_v ≤ m H(y)`: away from `S` the sup norms of `y` are
those of `u`, at most `1`, and their product is at least `m⁻¹`. -/
theorem placeProd_iSup_le_mul_mulHeight {ι : Type*} [Finite ι] {u : ι → K}
    (hu : ∀ i, IsIntegral ℤ (u i)) {m : ℝ} (hm0 : 0 < m)
    (hm : m⁻¹ ≤ ∏ᶠ v : FinitePlace K, ⨆ i, v (u i)) {x : ι → Kˣ}
    (hx : ∀ i, x i ∈ (S : Set (HeightOneSpectrum (𝓞 K))).unit K)
    (hy : (fun i ↦ u i * (x i : K)) ≠ 0) :
    placeProd S Set.univ (fun v ↦ ⨆ i, v (u i * x i)) ≤
      m * mulHeight (fun i ↦ u i * (x i : K)) := by
  classical
  set F : HeightOneSpectrum (𝓞 K) → ℝ := fun P ↦ ⨆ i, FinitePlace.mk P (u i * x i) with hF
  set G : HeightOneSpectrum (𝓞 K) → ℝ := fun P ↦ ⨆ i, FinitePlace.mk P (u i) with hG
  have hu0 : (u : ι → K) ≠ 0 := fun h ↦ hy (funext fun i ↦ by simp [congrFun h i])
  have hF0 : ∀ P, 0 ≤ F P := fun P ↦ Real.iSup_nonneg fun _ ↦ apply_nonneg _ _
  have hG0 : ∀ P, 0 ≤ G P := fun P ↦ Real.iSup_nonneg fun _ ↦ apply_nonneg _ _
  have hG1 : ∀ P, G P ≤ 1 := fun P ↦ Real.iSup_le (fun i ↦
    (Set.mem_integer_iff_finitePlace ∅ _).1 (mem_integer_of_isIntegral (hu i)) P (by simp))
    zero_le_one
  have hFG : ∀ P ∉ S, F P = G P := fun P hP ↦ by
    simp only [hF, hG, map_mul]
    congr 1
    funext i
    rw [(Set.mem_unit_iff_finitePlace _ _).1 (hx i) P (by simpa using hP), mul_one]
  set F₁ : HeightOneSpectrum (𝓞 K) → ℝ := fun P ↦ if P ∈ S then F P else 1 with hF₁
  set F₂ : HeightOneSpectrum (𝓞 K) → ℝ := fun P ↦ if P ∈ S then 1 else F P with hF₂
  have hFfin := hasFiniteMulSupport_iSup_mk hy
  have hF₁sub : Function.mulSupport F₁ ⊆ (S : Set (HeightOneSpectrum (𝓞 K))) := fun P hP ↦ by
    by_contra h
    exact hP (ite_eq_right fun h' ↦ h (Finset.mem_coe.2 h'))
  have hF₁fin : Function.HasFiniteMulSupport F₁ := Set.Finite.subset S.finite_toSet hF₁sub
  have hF₂fin : Function.HasFiniteMulSupport F₂ := hFfin.subset fun P hP ↦ by
    by_cases h : P ∈ S
    · exact absurd (ite_eq_left h) hP
    · exact Function.mem_mulSupport.2 ((ite_eq_right h).symm.trans_ne hP)
  have hsplit : ∏ᶠ P, F P = (∏ P ∈ S, F P) * ∏ᶠ P, F₂ P := by
    rw [show (∏ P ∈ S, F P) = ∏ᶠ P, F₁ P by
      rw [finprod_eq_finsetProd_of_mulSupport_subset F₁ hF₁sub]
      exact Finset.prod_congr rfl fun P hP ↦ (ite_eq_left hP).symm,
      ← finprod_mul_distrib hF₁fin hF₂fin]
    refine finprod_congr fun P ↦ ?_
    change F P = (if P ∈ S then F P else 1) * (if P ∈ S then 1 else F P)
    by_cases h : P ∈ S
    · rw [ite_eq_left h, ite_eq_left h, mul_one]
    · rw [ite_eq_right h, ite_eq_right h, one_mul]
  have hG_le : m⁻¹ ≤ ∏ᶠ P, F₂ P := by
    refine (hm.trans_eq finprod_iSup_eq).trans ?_
    refine finprod_le_finprod₀ (hasFiniteMulSupport_iSup_mk hu0) hG0 hF₂fin fun P ↦ ?_
    change G P ≤ (if P ∈ S then 1 else F P)
    by_cases h : P ∈ S
    · rw [ite_eq_left h]
      exact hG1 P
    · rw [ite_eq_right h, hFG P h]
  have hSprod : ∏ P ∈ S, F P ≤ m * ∏ᶠ P, F P := by
    rw [hsplit]
    have hS0 : 0 ≤ ∏ P ∈ S, F P := Finset.prod_nonneg fun P _ ↦ hF0 P
    calc ∏ P ∈ S, F P = m * ((∏ P ∈ S, F P) * m⁻¹) := by field_simp
      _ ≤ m * ((∏ P ∈ S, F P) * ∏ᶠ P, F₂ P) := by gcongr
  rw [NumberField.mulHeight_eq hy, finprod_iSup_eq]
  simp only [placeProd, Set.mulIndicator_univ]
  have hinf : 0 ≤ ∏ w : InfinitePlace K, (⨆ i, w (u i * x i)) ^ w.mult :=
    Finset.prod_nonneg fun w _ ↦ pow_nonneg (Real.iSup_nonneg fun _ ↦ apply_nonneg _ _) _
  calc _ ≤ (∏ w : InfinitePlace K, (⨆ i, w (u i * x i)) ^ w.mult) * (m * ∏ᶠ P, F P) :=
        mul_le_mul_of_nonneg_left hSprod hinf
    _ = _ := by ring

/-- **A prime of small norm**: some prime of `𝓞 K` (one above `2`) has norm at most `2 ^ d`. -/
theorem exists_absNorm_le_two_pow :
    ∃ P : HeightOneSpectrum (𝓞 K), Ideal.absNorm P.asIdeal ≤ 2 ^ finrank ℚ K := by
  set I : Ideal (𝓞 K) := Ideal.span {((2 : ℕ) : 𝓞 K)}
  have hI : Ideal.absNorm I = 2 ^ finrank ℚ K := by
    rw [Ideal.absNorm_span_natCast, RingOfIntegers.rank]
  have hItop : I ≠ ⊤ := fun h ↦ by
    have h1 := Ideal.absNorm_eq_one_iff.2 h
    rw [hI] at h1
    have := Nat.one_lt_two_pow (finrank_pos (R := ℚ) (M := K)).ne'
    omega
  obtain ⟨P, hP, hIP⟩ := Ideal.exists_le_maximal I hItop
  have hP0 : P ≠ ⊥ := fun h ↦ by
    have : ((2 : ℕ) : 𝓞 K) ∈ (⊥ : Ideal (𝓞 K)) := h ▸ hIP (Ideal.subset_span rfl)
    rw [Ideal.mem_bot] at this
    exact two_ne_zero (by exact_mod_cast this)
  refine ⟨⟨P, hP.isPrime, hP0⟩, ?_⟩
  rw [← hI]
  exact Nat.le_of_dvd (by rw [hI]; positivity) (Ideal.absNorm_dvd_absNorm_of_le hIP)

end NumberField
