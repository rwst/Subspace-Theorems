/-!
# The local Nullstellensatz inequality

Let `G` and `f` be finite families in `K[X_s | s ∈ σ]`, `deg f i ≤ δ`, and suppose that `X_none`,
the homogenizations `G^h` and the `f^h = homogenize δ f` have no common zero in projective space,
in the algebraic form: every `X_s` has a power in the ideal they generate. Then at any absolute
value `v` of `K`, a zero `P` of `G` with `‖P‖_v = max (1, |P_s|_v)` large has a large `f i`:

```text
c ‖P‖_v ^ δ ≤ |f i (P)|_v      for some i, once ‖P‖_v ≥ R,
```

with `c > 0` and `R` independent of `P` (`MvPolynomial.exists_le_abv_eval_of_pow_mem`). The proof
evaluates the identity `X_s ^ M = A₀ X_none + ∑ B_l G_l^h + ∑ A_i f_i^h` at `(1, P)`, with forms
`A` of the right degrees (`MvPolynomial.exists_sum_mul_eq_of_isHomogeneous`), at a coordinate `s`
where `|P_s|_v = ‖P‖_v`: the `G` terms vanish, the `X_none` term is `O(‖P‖_v ^ (M - 1))`, so the
`f` terms carry `‖P‖_v ^ M`.

This is how Corvaja–Zannier, *On a general Thue's equation*, Amer. J. Math. 126 (2004), Lemma 3.3,
gets `|f(P)|_v ≫ ‖P‖_v ^ δ` for the `f` not vanishing at the limit point at infinity of a
`v`-adically convergent sequence, here uniformly and without limits (Finding 3 of
`CorvajaZannier2004Thue/README.md`). By the Nullstellensatz the hypothesis says that `X₀`, `G^h`
and `f^h` have no common zero in projective space over an algebraic closure of `K`; the algebraic
form is the one stated and the one used.

## Implementation notes

⚠ **Any absolute value**, archimedean or not, and no completeness: the inequality is one
evaluation of a polynomial identity and the triangle inequality (`MvPolynomial.abv_eval_le`).

⚠ **`M ≥ δ + 1` is arranged, not assumed**: multiplying the identity by `X_s ^ (δ + 1)` makes the
exponents `M - 1` and `M - δ` honest subtractions.
-/

@[expose] public section

open Finset

namespace MvPolynomial

variable {K σ ι κ : Type*} [Field K] [Finite σ] [Finite ι] [Finite κ]

/-- **The local Nullstellensatz inequality.** If every `X_s` has a power in the ideal generated by
`X_none`, the homogenizations of the `G l` and the `homogenize δ (f i)`, `deg f i ≤ δ`, then at any
absolute value there are `c > 0` and `R` such that every zero `P` of the `G l` with `‖P‖_v ≥ R`
has `c ‖P‖_v ^ δ ≤ |f i (P)|_v` for some `i`. -/
theorem exists_le_abv_eval_of_pow_mem (v : AbsoluteValue K ℝ) (G : κ → MvPolynomial σ K)
    {f : ι → MvPolynomial σ K} {δ : ℕ} (hf : ∀ i, (f i).totalDegree ≤ δ)
    (hX : ∀ s, ∃ M, X (some s) ^ M ∈ Ideal.span (insert (X none)
      (Set.range (fun l ↦ homogenization (G l)) ∪ Set.range fun i ↦ homogenize δ (f i)))) :
    ∃ c > 0, ∃ R, ∀ P : σ → K, (∀ l, eval P (G l) = 0) →
      R ≤ ⨆ o : Option σ, v (o.elim 1 P) →
      ∃ i, c * (⨆ o : Option σ, v (o.elim 1 P)) ^ δ ≤ v (eval P (f i)) := by
  have := Fintype.ofFinite σ
  have := Fintype.ofFinite ι
  have := Fintype.ofFinite κ
  classical
  -- The generators, indexed by `Option (κ ⊕ ι)`, and their degrees.
  set h : Option (κ ⊕ ι) → MvPolynomial (Option σ) K := fun o ↦
    o.elim (X none) (Sum.elim (fun l ↦ homogenization (G l)) fun i ↦ homogenize δ (f i)) with hh
  set e : Option (κ ⊕ ι) → ℕ := fun o ↦
    o.elim 1 (Sum.elim (fun l ↦ (G l).totalDegree) fun _ ↦ δ) with he
  have hhom : ∀ o, (h o).IsHomogeneous (e o) := by
    rintro (_ | l | i)
    · exact isHomogeneous_X _ _
    · exact isHomogeneous_homogenization (G l)
    · exact isHomogeneous_homogenize (hf i)
  have hrange : Set.range h = insert (X none)
      (Set.range (fun l ↦ homogenization (G l)) ∪ Set.range fun i ↦ homogenize δ (f i)) := by
    ext F
    simp only [Set.mem_range, Option.exists, Sum.exists, Set.mem_insert_iff, Set.mem_union, h,
      Option.elim_none, Option.elim_some, Sum.elim_inl, Sum.elim_inr]
    constructor
    · rintro (h | ⟨l, h⟩ | ⟨i, h⟩)
      exacts [Or.inl h.symm, Or.inr (Or.inl ⟨l, h⟩), Or.inr (Or.inr ⟨i, h⟩)]
    · rintro (h | ⟨l, h⟩ | ⟨i, h⟩)
      exacts [Or.inl h.symm, Or.inr (Or.inl ⟨l, h⟩), Or.inr (Or.inr ⟨i, h⟩)]
  -- For each `s`, `X_s ^ M = ∑ A o h o` with `M ≥ δ + 1` and forms `A o` of degree `M - e o`.
  have hdec : ∀ s, ∃ M, δ + 1 ≤ M ∧ ∃ A : Option (κ ⊕ ι) → MvPolynomial (Option σ) K,
      (∀ o, (A o).IsHomogeneous (M - e o)) ∧ (∀ o, A o ≠ 0 → e o ≤ M) ∧
        ∑ o, A o * h o = X (some s) ^ M := by
    intro s
    obtain ⟨M, hM⟩ := hX s
    have hmem : X (some s) ^ (M + (δ + 1)) ∈ Ideal.span (Set.range h) := by
      rw [pow_add, hrange]
      exact Ideal.mul_mem_right _ _ hM
    exact ⟨M + (δ + 1), by omega,
      exists_sum_mul_eq_of_isHomogeneous hhom (isHomogeneous_X_pow _ _) hmem⟩
  choose M hM A hAhom _ hAsum using hdec
  -- The constants.
  set Cst : σ → Option (κ ⊕ ι) → ℝ := fun s o ↦
    ∑ m ∈ (dehomogenize (A s o)).support, v ((dehomogenize (A s o)).coeff m) with hCst
  have hCst0 : ∀ s o, 0 ≤ Cst s o := fun s o ↦ sum_nonneg fun _ _ ↦ apply_nonneg _ _
  set C : ℝ := 1 + ∑ s, ∑ o, Cst s o with hC
  have hC1 : 1 ≤ C := le_add_of_nonneg_right (sum_nonneg fun s _ ↦ sum_nonneg fun o _ ↦ hCst0 s o)
  have hCle : ∀ s o, Cst s o ≤ C := fun s o ↦ by
    have h1 : Cst s o ≤ ∑ o, Cst s o := single_le_sum (fun o _ ↦ hCst0 s o) (mem_univ o)
    have h2 : ∑ o, Cst s o ≤ ∑ s, ∑ o, Cst s o :=
      single_le_sum (f := fun s ↦ ∑ o, Cst s o) (fun s _ ↦ sum_nonneg fun o _ ↦ hCst0 s o)
        (mem_univ s)
    linarith
  set k : ℝ := (Fintype.card ι : ℝ) with hk
  have hk0 : 0 ≤ k := Nat.cast_nonneg _
  refine ⟨1 / (2 * C * (k + 1)), by positivity, 2 * C, fun P hP hR ↦ ?_⟩
  set n := ⨆ o : Option σ, v (o.elim 1 P) with hn
  have hn1 : 1 ≤ n := one_le_iSup_abv_optionElim v P
  have hn0 : 0 < n := zero_lt_one.trans_le hn1
  -- The coordinate where `‖P‖_v` is attained.
  obtain ⟨o, ho⟩ := exists_eq_ciSup_of_finite (f := fun o : Option σ ↦ v (o.elim 1 P))
  obtain ⟨s, rfl⟩ : ∃ s, o = some s := by
    rcases o with _ | s
    · simp only [Option.elim_none, map_one] at ho
      linarith
    · exact ⟨s, rfl⟩
  simp only [Option.elim_some] at ho
  set Ms := M s
  -- The identity at `(1, P)`.
  have hid : P s ^ Ms = eval P (dehomogenize (A s none)) +
      ∑ i, eval P (dehomogenize (A s (some (.inr i)))) * eval P (f i) := by
    have := congrArg (fun F ↦ eval P (dehomogenize F)) (hAsum s)
    simp only [Fintype.sum_option, Fintype.sum_sum_type] at this
    simp only [map_add, map_sum, map_mul, map_pow, h,
      Option.elim_none, Option.elim_some, Sum.elim_inl, Sum.elim_inr, dehomogenize_X_none,
      dehomogenize_homogenization, dehomogenize_homogenize, dehomogenize_X_some, eval_X, hP,
      mul_zero, sum_const_zero, zero_add, mul_one] at this
    exact this.symm
  -- The bounds on the coefficients' values.
  have hA : ∀ o, v (eval P (dehomogenize (A s o))) ≤ C * n ^ (Ms - e o) := fun o ↦
    (abv_eval_le v P _ (totalDegree_dehomogenize_le (hAhom s o))).trans
      (mul_le_mul_of_nonneg_right (hCle s o) (pow_nonneg hn0.le _))
  by_contra hcon
  push Not at hcon
  have hMδ : δ ≤ Ms := by have := hM s; omega
  have hsum : v (∑ i, eval P (dehomogenize (A s (some (.inr i)))) * eval P (f i)) ≤
      k * (C * (1 / (2 * C * (k + 1)))) * n ^ Ms := by
    refine (v.sum_le _ _).trans ?_
    calc ∑ i, v (eval P (dehomogenize (A s (some (.inr i)))) * eval P (f i))
        ≤ ∑ _i : ι, C * n ^ (Ms - δ) * (1 / (2 * C * (k + 1)) * n ^ δ) := by
          refine sum_le_sum fun i _ ↦ ?_
          rw [map_mul]
          exact mul_le_mul (hA _) (hcon i).le (apply_nonneg _ _) (by positivity)
      _ = k * (C * (1 / (2 * C * (k + 1)))) * n ^ Ms := by
          rw [sum_const, card_univ, nsmul_eq_mul, ← hk]
          rw [show n ^ Ms = n ^ (Ms - δ) * n ^ δ by rw [← pow_add, Nat.sub_add_cancel hMδ]]
          ring
  have hnone : v (eval P (dehomogenize (A s none))) ≤ C * n ^ (Ms - 1) := hA none
  have hmain : n ^ Ms ≤ C * n ^ (Ms - 1) + k * (C * (1 / (2 * C * (k + 1)))) * n ^ Ms := by
    calc n ^ Ms = v (P s ^ Ms) := by rw [map_pow, ho]
      _ ≤ _ := by rw [hid]; exact (v.add_le _ _).trans (add_le_add hnone hsum)
  -- `C n ^ (M - 1) ≤ n ^ M / 2` and the `f` terms are `< n ^ M / 2`.
  have hpow : n ^ Ms = n * n ^ (Ms - 1) := by
    rw [← pow_succ', Nat.sub_add_cancel (by have := hM s; omega)]
  have hR' : 2 * C ≤ n := hR
  have h1 : C * n ^ (Ms - 1) ≤ n ^ Ms / 2 := by
    rw [hpow]
    have : 0 ≤ n ^ (Ms - 1) := pow_nonneg hn0.le _
    nlinarith
  have h2 : k * (C * (1 / (2 * C * (k + 1)))) = k / (2 * (k + 1)) := by
    field_simp
  have h3 : k / (2 * (k + 1)) < 1 / 2 := by
    rw [div_lt_div_iff₀ (by positivity) (by norm_num)]
    linarith
  have hpos : 0 < n ^ Ms := pow_pos hn0 _
  rw [h2] at hmain
  nlinarith

end MvPolynomial
