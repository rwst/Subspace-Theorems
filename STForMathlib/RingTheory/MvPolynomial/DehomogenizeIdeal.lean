/-!
# Dehomogenization of an ideal

Let `G i` be polynomials in `K[X_s | s ∈ σ]` and `G^h i = homogenize (deg G i) (G i)` their
homogenizations, in the variables `X_o`, `o : Option σ`. If `X_none` is a nonzerodivisor modulo
`(G^h)` (the variety `G^h = 0` meets the hyperplane at infinity properly), then:

* a form `F` with `F(1, X) ∈ (G)` lies in `(G^h)`
  (`MvPolynomial.mem_span_homogenization_of_dehomogenize_mem`), so dehomogenization identifies
  the forms of degree `N` modulo `(G^h)` with the polynomials of degree `≤ N` modulo `(G)`;
* a polynomial of degree `≤ N` in `(G)` is `∑ A i G i` with `deg A i + deg G i ≤ N`
  (`MvPolynomial.exists_sum_mul_eq_of_mem_span`): the degrees fit.

The second rests on the graded form of ideal membership, for any forms `h i` of degrees `d i`: a
form of degree `M` in `(h)` is `∑ A i h i` with `A i` a form of degree `M - d i`
(`MvPolynomial.exists_sum_mul_eq_of_isHomogeneous`).

For one nonconstant `p`, `X_none` does not divide `p^h`
(`MvPolynomial.not_X_none_dvd_homogenization`: the monomials of top degree of `p` carry no
`X_none`), so `(X_none, p^h)` has height `2`
(`MvPolynomial.height_span_X_none_homogenization`): a hypersurface meets the hyperplane at
infinity properly. The homogenization of a prime is prime
(`MvPolynomial.prime_homogenization`, by the graded primality criterion).

This is Corvaja–Zannier, *On a general Thue's equation*, Amer. J. Math. 126 (2004), Lemma 2.4.
-/

@[expose] public section

open Finset

namespace MvPolynomial

variable {σ K ι : Type*} [Field K]

/-- The homogenization `p^h = homogenize (deg p) p` of `p` in its own degree. -/
noncomputable def homogenization (p : MvPolynomial σ K) : MvPolynomial (Option σ) K :=
  homogenize p.totalDegree p

theorem isHomogeneous_homogenization (p : MvPolynomial σ K) :
    (homogenization p).IsHomogeneous p.totalDegree :=
  isHomogeneous_homogenize le_rfl

theorem dehomogenize_homogenization (p : MvPolynomial σ K) :
    dehomogenize (homogenization p) = p :=
  dehomogenize_homogenize _ _

section Finite

variable [Finite ι]

/-- **The kernel of dehomogenization** (Corvaja–Zannier 2004, Lemma 2.4). If `X_none` is a
nonzerodivisor modulo `(G^h)`, a form `F` with `F(1, X) ∈ (G)` lies in `(G^h)`. -/
theorem mem_span_homogenization_of_dehomogenize_mem {G : ι → MvPolynomial σ K}
    (hX : (Ideal.span (Set.range fun i ↦ homogenization (G i))).colon {X none} =
      Ideal.span (Set.range fun i ↦ homogenization (G i)))
    {F : MvPolynomial (Option σ) K} {N : ℕ} (hF : F.IsHomogeneous N)
    (h : dehomogenize F ∈ Ideal.span (Set.range G)) :
    F ∈ Ideal.span (Set.range fun i ↦ homogenization (G i)) := by
  have := Fintype.ofFinite ι
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp h
  set D := ∑ i, ((a i).totalDegree + (G i).totalDegree)
  have hD : ∀ i, (a i).totalDegree + (G i).totalDegree ≤ D := fun i ↦
    single_le_sum (f := fun i ↦ (a i).totalDegree + (G i).totalDegree) (fun _ _ ↦ Nat.zero_le _)
      (mem_univ i)
  have key := homogenize_add_dehomogenize hF D
  rw [← ha, map_sum] at key
  refine mem_of_pow_mul_mem_of_colon_eq hX D ?_
  rw [mul_comm, ← key]
  refine Ideal.sum_mem _ fun i _ ↦ ?_
  have hi := hD i
  rw [smul_eq_mul, show N + D = (N + D - (G i).totalDegree) + (G i).totalDegree by omega,
    homogenize_mul (by omega) le_rfl]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

end Finite

variable [Fintype ι]

/-- **Degrees in a homogeneous ideal.** A form `F` of degree `M` in the ideal generated by forms
`h i` of degrees `d i` is `∑ A i h i` with `A i` a form of degree `M - d i`, and `A i = 0` unless
`d i ≤ M`. -/
theorem exists_sum_mul_eq_of_isHomogeneous {τ : Type*} {h : ι → MvPolynomial τ K} {d : ι → ℕ}
    (hh : ∀ i, (h i).IsHomogeneous (d i)) {F : MvPolynomial τ K} {M : ℕ}
    (hF : F.IsHomogeneous M) (hmem : F ∈ Ideal.span (Set.range h)) :
    ∃ A : ι → MvPolynomial τ K, (∀ i, (A i).IsHomogeneous (M - d i)) ∧
      (∀ i, A i ≠ 0 → d i ≤ M) ∧ ∑ i, A i * h i = F := by
  classical
  obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
  refine ⟨fun i ↦ if d i ≤ M then homogeneousComponent (M - d i) (b i) else 0, fun i ↦ ?_,
    fun i hi ↦ ?_, ?_⟩
  · dsimp only
    split_ifs
    · exact homogeneousComponent_isHomogeneous _ _
    · exact isHomogeneous_zero _ _ _
  · by_contra hle
    exact hi (by simp [hle])
  · have : F = homogeneousComponent M F := (hF.weightedHomogeneousComponent_same).symm
    rw [this, ← hb, map_sum]
    refine sum_congr rfl fun i _ ↦ ?_
    rw [smul_eq_mul]
    dsimp only
    split_ifs with hi
    · rw [show M = (M - d i) + d i by omega]
      have := (hh i).weightedHomogeneousComponent_add_mul (b i) (M - d i)
      rw [show M - d i + d i - d i = M - d i by omega]
      exact this.symm
    · rw [zero_mul]
      exact ((hh i).weightedHomogeneousComponent_mul_eq_zero _ (by simpa using hi)).symm

/-- **The degrees fit** (Corvaja–Zannier 2004, Lemma 2.4). If `X_none` is a nonzerodivisor modulo
`(G^h)`, a polynomial of degree `≤ N` in `(G)` is `∑ A i G i` with `deg A i + deg G i ≤ N`. -/
theorem exists_sum_mul_eq_of_mem_span {G : ι → MvPolynomial σ K}
    (hX : (Ideal.span (Set.range fun i ↦ homogenization (G i))).colon {X none} =
      Ideal.span (Set.range fun i ↦ homogenization (G i)))
    {q : MvPolynomial σ K} (hq : q ∈ Ideal.span (Set.range G)) {N : ℕ} (hN : q.totalDegree ≤ N) :
    ∃ A : ι → MvPolynomial σ K, (∀ i, A i ≠ 0 → (A i).totalDegree + (G i).totalDegree ≤ N) ∧
      ∑ i, A i * G i = q := by
  classical
  have hF := isHomogeneous_homogenize (R := K) hN
  have hmem := mem_span_homogenization_of_dehomogenize_mem hX hF
    (by rwa [dehomogenize_homogenize])
  obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
  set B : ι → MvPolynomial (Option σ) K := fun i ↦
    if (G i).totalDegree ≤ N then homogeneousComponent (N - (G i).totalDegree) (b i) else 0
  have hcomp : homogenize N q = ∑ i, B i * homogenization (G i) := by
    have : homogenize N q = homogeneousComponent N (homogenize N q) :=
      (hF.weightedHomogeneousComponent_same).symm
    rw [this, ← hb, map_sum]
    refine sum_congr rfl fun i _ ↦ ?_
    rw [smul_eq_mul]
    simp only [B]
    split_ifs with hi
    · rw [show N = (N - (G i).totalDegree) + (G i).totalDegree by omega]
      have := (isHomogeneous_homogenization (G i)).weightedHomogeneousComponent_add_mul (b i)
        (N - (G i).totalDegree)
      rw [show N - (G i).totalDegree + (G i).totalDegree - (G i).totalDegree =
        N - (G i).totalDegree by omega]
      exact this
    · rw [zero_mul]
      exact (isHomogeneous_homogenization (G i)).weightedHomogeneousComponent_mul_eq_zero _
        (by simpa using hi)
  refine ⟨fun i ↦ dehomogenize (B i), fun i hi ↦ ?_, ?_⟩
  · simp only [B] at hi ⊢
    split_ifs at hi ⊢ with hle
    · have := totalDegree_dehomogenize_le
        (homogeneousComponent_isHomogeneous (N - (G i).totalDegree) (b i))
      omega
    · exact absurd (map_zero _) hi
  · conv_rhs => rw [← dehomogenize_homogenize N q, hcomp]
    rw [map_sum]
    refine sum_congr rfl fun i _ ↦ ?_
    rw [map_mul, dehomogenize_homogenization]

/-- The homogenization of a nonconstant polynomial has no constant term. -/
theorem constantCoeff_homogenization {p : MvPolynomial σ K}
    (hp : 0 < p.totalDegree) : constantCoeff (homogenization p) = 0 := by
  rw [constantCoeff_eq]
  refine (isHomogeneous_homogenization p).coeff_eq_zero fun h ↦ ?_
  simp [Finsupp.degree] at h
  omega

/-- **`X_none` does not divide a homogenization**: the monomials of top degree of `p` have no
`X_none` in `p^h`. -/
theorem not_X_none_dvd_homogenization {p : MvPolynomial σ K} (hp : p ≠ 0) :
    ¬ X none ∣ homogenization p := by
  classical
  rintro ⟨c, hc⟩
  obtain ⟨d, hd, hdeg⟩ := Finset.exists_mem_eq_sup p.support (support_nonempty.mpr hp)
    fun s ↦ s.sum fun _ e ↦ e
  set e := homogenizeExp p.totalDegree d
  have h1 : (homogenization p).coeff e ≠ 0 := by
    rw [homogenization, coeff_homogenize, some_homogenizeExp]
    simpa [e] using mem_support_iff.mp hd
  have h0 : e none = 0 := by
    change (d.optionElim (p.totalDegree - d.degree)) none = 0
    rw [Finsupp.optionElim_apply_none]
    have : p.totalDegree = d.degree := hdeg
    omega
  refine h1 ?_
  rw [hc, coeff_X_mul']
  simp [h0]

/-- **`(X_none, p^h)` has height `2`** for a nonconstant `p`: `X_none` is a nonzerodivisor
modulo `(p^h)`. -/
theorem height_span_X_none_homogenization [Finite σ] {p : MvPolynomial σ K}
    (hp : 0 < p.totalDegree) :
    (Ideal.span {X none, homogenization p}).height = 2 := by
  have hp0 : p ≠ 0 := fun h ↦ by simp [h] at hp
  have hh0 : homogenization p ≠ 0 := fun h ↦ hp0 (by
    rw [← dehomogenize_homogenization p, h, map_zero])
  set φ : Fin 2 → MvPolynomial (Option σ) K := ![homogenization p, X none]
  have hrange : Set.range φ = {X none, homogenization p} := by
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.pair_comm]
    rfl
  refine le_antisymm ?_ ?_
  · refine (Ideal.height_span_le_ncard_of_span_ne_top (Set.toFinite _) fun htop ↦ ?_).trans ?_
    · have hle : Ideal.span {X none, homogenization p} ≤
          RingHom.ker (constantCoeff : MvPolynomial (Option σ) K →+* K) := by
        rw [Ideal.span_le]
        rintro _ (rfl | rfl)
        · simp [RingHom.mem_ker]
        · rw [SetLike.mem_coe, RingHom.mem_ker, constantCoeff_eq]
          exact (isHomogeneous_homogenization p).coeff_eq_zero (by simp; omega)
      exact (RingHom.ker_ne_top _) (top_le_iff.mp (htop ▸ hle))
    · exact_mod_cast (Set.ncard_insert_le _ _).trans (by simp)
  · have h := Ideal.natCast_le_height_span_range_of_colon_eq (φ := φ) fun j ↦ by
      refine le_antisymm (fun y hy ↦ ?_) fun y hy ↦
        Submodule.mem_colon_singleton.mpr (by rw [smul_eq_mul]; exact Ideal.mul_mem_right _ _ hy)
      rw [Submodule.mem_colon_singleton, smul_eq_mul] at hy
      fin_cases j
      · have : φ '' Set.Iio 0 = ∅ := by simp
        simp only [Fin.zero_eta, this, Ideal.span_empty, Submodule.mem_bot] at hy ⊢
        exact (mul_eq_zero.mp hy).resolve_right hh0
      · have : φ '' Set.Iio 1 = {homogenization p} := by
          ext x
          simp only [Set.mem_image, Set.mem_Iio, Set.mem_singleton_iff]
          constructor
          · rintro ⟨i, hi, rfl⟩
            fin_cases i
            · rfl
            · exact absurd hi (lt_irrefl _)
          · rintro rfl
            exact ⟨0, by decide, rfl⟩
        simp only [Fin.mk_one, this, Ideal.mem_span_singleton] at hy ⊢
        obtain ⟨c, hc⟩ := hy
        have hX : Prime (X none : MvPolynomial (Option σ) K) := X_prime
        have hdvd : X none ∣ homogenization p * c := ⟨y, by rw [← hc]; simp [φ, mul_comm]⟩
        obtain ⟨c', rfl⟩ := (hX.dvd_or_dvd hdvd).resolve_left (not_X_none_dvd_homogenization hp0)
        refine ⟨c', mul_left_cancel₀ (X_ne_zero (none : Option σ)) ?_⟩
        have : y * φ 1 = homogenization p * (X none * c') := hc
        simp only [φ, Matrix.cons_val_one, Matrix.cons_val_zero] at this
        rw [mul_comm, this]
        ring
    rw [hrange] at h
    exact_mod_cast h

/-- An irreducible polynomial is not constant. -/
theorem totalDegree_pos_of_irreducible {p : MvPolynomial σ K} (hp : Irreducible p) :
    0 < p.totalDegree := by
  by_contra h
  have hC : p = C (p.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp (by omega)
  have hc : p.coeff 0 ≠ 0 := fun h0 ↦ hp.ne_zero (by rw [hC, h0, map_zero])
  exact hp.not_isUnit (hC ▸ (Ne.isUnit hc).map C)

attribute [local instance] gradedAlgebra in
/-- **The homogenization of a prime is prime.** By the graded primality criterion it suffices to
test forms `x`, `y` with `p^h ∣ x y`: then `p` divides `x(1, X)` or `y(1, X)`, say
`x(1, X) = p c`, and `x = X_none ^ k (p c)^h = X_none ^ k p^h c^h`. -/
theorem prime_homogenization {p : MvPolynomial σ K} (hp : Prime p) : Prime (homogenization p) := by
  have hh0 : homogenization p ≠ 0 := fun h ↦ hp.ne_zero (by
    rw [← dehomogenize_homogenization p, h, map_zero])
  -- A form whose dehomogenization is divisible by `p` is divisible by `p^h`.
  have hdvd : ∀ {x : MvPolynomial (Option σ) K} {m : ℕ}, x.IsHomogeneous m →
      p ∣ dehomogenize x → homogenization p ∣ x := by
    intro x m hx ⟨c, hc⟩
    by_cases hc0 : c = 0
    · rw [← homogenize_dehomogenize hx, hc, hc0, mul_zero, map_zero]
      exact dvd_zero _
    set d := dehomogenize x with hd
    have hdeg : d.totalDegree = p.totalDegree + c.totalDegree := by
      rw [hc, totalDegree_mul_of_isDomain hp.ne_zero hc0]
    have hx' : x = homogenization d * X none ^ (m - d.totalDegree) := by
      have := homogenize_add_eq_X_pow_mul (le_refl d.totalDegree) (m - d.totalDegree)
      rw [Nat.add_sub_cancel' (totalDegree_dehomogenize_le hx), homogenize_dehomogenize hx] at this
      exact this
    have hhd : homogenization d = homogenization p * homogenization c := by
      rw [homogenization, hdeg, hc, homogenize_mul le_rfl le_rfl]
      rfl
    exact ⟨homogenization c * X none ^ (m - d.totalDegree), by rw [hx', hhd]; ring⟩
  rw [← Ideal.span_singleton_prime hh0]
  refine Ideal.IsHomogeneous.isPrime_of_homogeneous_mem_or_mem
    (Ideal.homogeneous_span _ _ fun x hx ↦ ⟨p.totalDegree, by
      rw [Set.mem_singleton_iff.mp hx, mem_homogeneousSubmodule]
      exact isHomogeneous_homogenization p⟩) ?_ ?_
  · rw [Ne, Ideal.span_singleton_eq_top]
    intro hu
    exact hp.not_isUnit (dehomogenize_homogenization p ▸ hu.map dehomogenize)
  · rintro x y ⟨m, hx⟩ ⟨n, hy⟩ hxy
    rw [mem_homogeneousSubmodule] at hx hy
    simp only [Ideal.mem_span_singleton] at hxy ⊢
    have := map_dvd (dehomogenize (R := K) (σ := σ)) hxy
    rw [dehomogenize_homogenization, map_mul] at this
    rcases hp.dvd_or_dvd this with h | h
    exacts [Or.inl (hdvd hx h), Or.inr (hdvd hy h)]

end MvPolynomial
