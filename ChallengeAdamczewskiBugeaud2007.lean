@[expose] public section
open Filter
namespace Function
variable {α : Type*}
def morphismIter (φ : α → List α) (n : ℕ) (W : List α) : List α :=
  (fun W ↦ W.flatMap φ)^[n] W
variable {φ : α → List α}
def IsProlongable (φ : α → List α) (c : α) : Prop :=
  ∃ W, φ c = c :: W ∧ ∀ k, morphismIter φ k W ≠ []
def HasPrefix (a : ℕ → α) (L : List α) : Prop :=
  ∀ i < L.length, L[i]? = some (a i)
def IsGeneratedByMorphism (φ : α → List α) (a : ℕ → α) : Prop :=
  IsProlongable φ (a 0) ∧ ∀ k, HasPrefix a (morphismIter φ k [a 0])
def IsRecurrent (a : ℕ → α) : Prop :=
  ∀ i, ∃ j, j ≠ i ∧ a j = a i
end Function
end
