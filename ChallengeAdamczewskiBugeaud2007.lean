namespace Function
variable {α β : Type*}
def kKernel (k : ℕ) (a : ℕ → α) : Set (ℕ → α) :=
  {s | ∃ i r, r < k ^ i ∧ s = fun n ↦ a (k ^ i * n + r)}
def IsAutomatic (a : ℕ → α) : Prop :=
  ∃ k, 2 ≤ k ∧ (kKernel k a).Finite
end Function
