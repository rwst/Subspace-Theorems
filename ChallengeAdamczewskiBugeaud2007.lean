  1 < τ ∧ IsIntegral ℤ τ ∧ (∀ z ∈ (minpoly ℚ τ).aroots ℂ, z ≠ (τ : ℂ) → ‖z‖ ≤ 1) ∧
    ∃ z ∈ (minpoly ℚ τ).aroots ℂ, z ≠ (τ : ℂ) ∧ ‖z‖ = 1
end
